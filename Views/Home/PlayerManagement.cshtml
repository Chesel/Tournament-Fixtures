@model List<PlayerExportViewModel>
@{
    ViewBag.Title = "Player Management";
    var selectedTournament = ViewBag.SelectedTournament?.ToString();
    var tournaments = ViewBag.Tournaments as List<SelectListItem>;
    var selecteddistricts = ViewBag.SelectedDistrict?.ToString();
    var districts = ViewBag.Districts as List<SelectListItem>;
}

<h2>Player Management</h2>

@using (Html.BeginForm("PlayerManagement", "Home", FormMethod.Get, new { @class = "mb-3" }))
{
    <div class="form-group row">
        <label for="tournamentId" class="col-sm-2 col-form-label">Filter by Tournament:</label>
        <div class="col-sm-6">
            <select id="tournamentId" name="tournamentId" class="form-control" onchange="this.form.submit()">
                <option value="">-- All Tournaments --</option>
                @foreach (var tournament in tournaments)
                {
                    if (tournament.Value == selectedTournament)
                    {
                        <option value="@tournament.Value" selected>@tournament.Text</option>
                    }
                    else
                    {
                        <option value="@tournament.Value">@tournament.Text</option>
                    }
                }
            </select>
        </div>
    </div>
    <div class="form-group row">
        <label for="districtId" class="col-sm-2 col-form-label">Filter by District:</label>
        <div class="col-sm-6">
            <select id="districtId" name="districtId" class="form-control" onchange="this.form.submit()">
                <option value="">-- All Districts --</option>
                @foreach (var district in districts)
                {
                    if (district.Value == selecteddistricts)
                    {
                        <option value="@district.Value" selected>@district.Text</option>
                    }
                    else
                    {
                        <option value="@district.Value">@district.Text</option>
                    }
                }
            </select>
        </div>
    </div>
}

@using (Html.BeginForm("ExportPlayerToExcel", "Home", FormMethod.Post, new { style = "display:inline;" }))
{
    <input type="hidden" name="tournamentId" value="@ViewBag.SelectedTournament" />
    <input type="hidden" name="districtId" value="@ViewBag.SelectedDistrict" />
    <button type="submit" class="btn btn-outline-success mb-3">Export to Excel</button>
}

@{
    var weightCatOptions = ViewBag.WeightCatOptions as List<SelectListItem>;
    var districtOptionsForEdit = ViewBag.DistrictOptionsForEdit as List<SelectListItem>;
}

<table id="playerTable" class="table table-bordered display">
    <thead class="thead-dark">
        <tr>
            <th>Player Name</th>
            <th>Parent Name</th>
            <th>Gender</th>
            <th>Mobile No</th>
            <th>Email</th>
            <th>DOB</th>
            <th>Category</th>
            <th>Weight Category</th>
            <th>District</th>
            <th>Club Name</th>
            <th>Remarks</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr data-id="@item.TrUserId">
                <td>
                    <span class="display-value">@(item.Name ?? "-")</span>
                    <input type="text" class="form-control form-control-sm edit-input edit-name" style="display:none;" value="@item.Name" />
                </td>
                <td>@(item.FatherName ?? "-")</td>
                <td>@(item.Gender ?? "-")</td>
                <td>@(item.MobileNo ?? "-")</td>
                <td>@(item.Email ?? "-")</td>
                <td>@(item.Dob?.ToString("dd-MM-yyyy") ?? "-")</td>
                <td>@(item.CategoryName ?? "-")</td>
                <td>
                    <span class="display-value">@(item.WeighCatName ?? "-")</span>
                    <select class="form-control form-control-sm edit-input edit-weightcat" style="display:none;">
                        @foreach (var w in weightCatOptions)
                        {
                            if (w.Value == item.WeightCatId?.ToString())
                            {
                                <option value="@w.Value" selected>@w.Text</option>
                            }
                            else
                            {
                                <option value="@w.Value">@w.Text</option>
                            }
                        }
                    </select>
                </td>
                <td>
                    <span class="display-value">@(item.District ?? "-")</span>
                    <select class="form-control form-control-sm edit-input edit-district" style="display:none;">
                        @foreach (var d in districtOptionsForEdit)
                        {
                            if (d.Value == item.DistrictId?.ToString())
                            {
                                <option value="@d.Value" selected>@d.Text</option>
                            }
                            else
                            {
                                <option value="@d.Value">@d.Text</option>
                            }
                        }
                    </select>
                </td>
                <td>@(item.ClubName ?? "-")</td>
                <td>@(item.Remarks ?? "-")</td>
                <td>
                    <button type="button" class="btn btn-sm btn-outline-primary edit-btn">Edit</button>
                    <button type="button" class="btn btn-sm btn-success save-btn" style="display:none;">Save</button>
                    <button type="button" class="btn btn-sm btn-secondary cancel-btn" style="display:none;">Cancel</button>
                    <button type="button" class="btn btn-sm btn-outline-danger delete-btn">Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>
@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#playerTable').DataTable({
                "paging": true,
                "searching": true,
                "ordering": true
            });
            $(document).on('click', '.edit-btn', function () {
    var row = $(this).closest('tr');
    row.find('.display-value').hide();
    row.find('.edit-input').show();
    row.find('.edit-btn').hide();
    row.find('.save-btn, .cancel-btn').show();
});

$(document).on('click', '.cancel-btn', function () {
    var row = $(this).closest('tr');
    row.find('.edit-input').hide();
    row.find('.display-value').show();
    row.find('.save-btn, .cancel-btn').hide();
    row.find('.edit-btn').show();
});

$(document).on('click', '.save-btn', function () {
    var row = $(this).closest('tr');
    var trUserId = row.data('id');
    var name = row.find('.edit-name').val();
    var weightCatId = row.find('.edit-weightcat').val();
    var districtId = row.find('.edit-district').val();

    $.ajax({
        url: '@Url.Action("UpdatePlayerInline", "Home")',
        type: 'POST',
        data: { trUserId: trUserId, name: name, weightCatId: weightCatId, districtId: districtId },
        success: function (result) {
            if (result.success) {
                row.find('.edit-name').closest('td').find('.display-value').text(result.name);
                row.find('.edit-weightcat').closest('td').find('.display-value').text(result.weightCatName);
                row.find('.edit-district').closest('td').find('.display-value').text(result.districtName);
                row.find('.edit-input').hide();
                row.find('.display-value').show();
                row.find('.save-btn, .cancel-btn').hide();
                row.find('.edit-btn').show();
            } else {
                alert(result.message || 'Update failed.');
            }
        },
        error: function () {
            alert('Failed to save changes.');
        }
    });
});

$(document).on('click', '.delete-btn', function () {
    if (!confirm('Remove this player?')) return;
    var row = $(this).closest('tr');
    var trUserId = row.data('id');

    $.ajax({
        url: '@Url.Action("DeletePlayerInline", "Home")',
        type: 'POST',
        data: { trUserId: trUserId },
        success: function (result) {
            if (result.success) {
                row.fadeOut(300, function () { $(this).remove(); });
            } else {
                alert(result.message || 'Delete failed.');
            }
        },
        error: function () {
            alert('Failed to delete player.');
        }
    });
});
        });
    </script>
}
