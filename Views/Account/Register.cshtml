@model RegisterViewModel

<div class="container mt-5">
    <div class="card shadow-lg">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">User Registration</h4>
        </div>
        <div class="card-body">
            @if (TempData["Message"] != null)
            {
                <div class="alert alert-success">@TempData["Message"]</div>
            }

            @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                <div class="row">
                    <!-- Name -->
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(m => m.Name)
                            @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <!-- Photo Upload -->
                    <div class="col-md-6 d-flex align-items-center">
                        <div class="form-group w-100 text-center">
                            <label for="photoInput" style="cursor: pointer;">
                                <i class="fas fa-upload fa-2x text-primary"></i>
                                <div>Upload Photo</div>
                            </label>
                            <input type="file" name="Photo" id="photoInput" accept="image/*" style="display:none;" />
                            @Html.ValidationMessageFor(m => m.Photo, "", new { @class = "text-danger" })

                            <!-- Preview -->
                            <div class="mt-3">
                                <img id="photoPreview" src="#" alt="Preview"
                                     style="display:none; max-height: 150px; border: 1px solid #ddd; padding: 5px;" />
                            </div>
                        </div>
                    </div>

                    <div class="form-group col-md-6">
                        @Html.LabelFor(m => m.GenderId)
                        @Html.DropDownListFor(m => m.GenderId, Model.GenderOptions, "-- Select Gender --", new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.GenderId, "", new { @class = "text-danger" })
                    </div>

                    <!-- Date of Birth -->
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(m => m.DateOfBirth)
                            @Html.TextBoxFor(m => m.DateOfBirth, "{0:yyyy-MM-dd}", new { type = "date", @class = "form-control", id = "dob" })
                            @Html.ValidationMessageFor(m => m.DateOfBirth, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <!-- Category -->
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Category</label>
                            <input type="text" id="category" class="form-control" readonly />
                        </div>
                    </div>

                    <!-- Aadhaar -->
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(m => m.Aadhaar)
                            @Html.TextBoxFor(m => m.Aadhaar, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Aadhaar, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <!-- Height -->
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(m => m.Height)
                            @Html.TextBoxFor(m => m.Height, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Height, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <!-- Weight -->
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(m => m.Weight)
                            @Html.TextBoxFor(m => m.Weight, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Weight, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <!-- Address -->
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(m => m.Address)
                            @Html.TextBoxFor(m => m.Address, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <!-- PinCode -->
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(m => m.PinCode)
                            @Html.TextBoxFor(m => m.PinCode, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.PinCode, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <!-- Phone -->
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(m => m.Phone)
                            @Html.TextBoxFor(m => m.Phone, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <!-- Email -->
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(m => m.Email)
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <!-- Password -->
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(m => m.Password)
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <!-- Confirm Password -->
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(m => m.ConfirmPassword)
                            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="text-center mt-3">
                    <button type="submit" class="btn btn-success">Register</button>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @Html.Partial("_ValidationScriptsPartial")

    <script>
        // Preview logic for image
        document.getElementById('photoInput').addEventListener('change', function(event) {
            const file = event.target.files[0];
            const preview = document.getElementById('photoPreview');

            if (file && file.type.startsWith('image/')) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.src = e.target.result;
                    preview.style.display = 'block';
                };
                reader.readAsDataURL(file);
            } else {
                preview.style.display = 'none';
            }
        });

        // DOB -> Category logic
        document.getElementById('dob').addEventListener('change', function() {
            const dob = new Date(this.value);
            const today = new Date();
            let age = today.getFullYear() - dob.getFullYear();
            const m = today.getMonth() - dob.getMonth();
            if (m < 0 || (m === 0 && today.getDate() < dob.getDate())) {
                age--;
            }

            let category = '';
            if (age < 7) category = 'Kids';
            else if (age >= 7 && age <= 11) category = 'SubJunior';
            else if (age >= 12 && age <= 14) category = 'Cadet';
            else if (age >= 15 && age <= 17) category = 'Junior';
            else category = 'Senior';

            document.getElementById('category').value = category;
        });
    </script>
}
